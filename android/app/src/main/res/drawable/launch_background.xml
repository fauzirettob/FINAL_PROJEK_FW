<?xml version="1.0" encoding="utf-8"?>
<!-- Native Android splash screen yang muncul SEBELUM Flutter engine siap -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background hijau solid, senada dengan custom splash screen Flutter -->
    <item android:drawable="@color/splash_background" />

    <!-- Logo sekolah putih di tengah (splash_logo.png di folder mipmap-*) -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/splash_logo" />
    </item>
</layer-list>
